# Database credentials
POSTGRES_USER=shift
POSTGRES_PASSWORD=shift_password_placeholder
POSTGRES_DB=shift_db
POSTGRES_HOST=db
POSTGRES_PORT=5432
DATABASE_URL=postgresql://shift:shift_password_placeholder@db:5432/shift_db

# Auth
JWT_SECRET=replace_with_a_secure_jwt_secret_key

# LLM Provider configuration (gemini or groq)
LLM_PROVIDER=groq
GROQ_API_KEY=your_groq_api_key_placeholder
GEMINI_API_KEY=your_gemini_api_key_placeholder
# Free-tier model names change. Check the provider's /models list if you get a 404.
LLM_MODEL=openai/gpt-oss-20b
LLM_TIMEOUT_SECONDS=3.0

# Controllable clock override (optional ISO string for reproducible tests and demos)
# FIXED_NOW=2026-11-20T14:00:00+05:30
